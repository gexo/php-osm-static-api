{
  "name": "gexo/php-osm-static-api",
  "type": "library",
  "description": "PHP library to easily get static image from OpenStreetMap (OSM), add markers and draw lines. Fork of dantsu/php-osm-static-api with PHP 8.1 - 8.5 support.",
  "keywords": [
    "php",
    "osm",
    "openstreetmap",
    "map",
    "static",
    "image",
    "maps",
    "api"
  ],
  "homepage": "https://github.com/gexo/php-osm-static-api",
  "license": "MIT",
  "authors": [
    {
      "name": "Franck ALARY",
      "homepage": "https://github.com/DantSu",
      "role": "Original author"
    },
    {
      "name": "Stefan Oswald",
      "homepage": "https://github.com/gexo",
      "role": "Fork maintainer"
    }
  ],
  "support": {
    "issues": "https://github.com/gexo/php-osm-static-api/issues",
    "source": "https://github.com/gexo/php-osm-static-api"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/gexo/php-image-editor",
      "no-api": true
    }
  ],
  "require": {
    "php": ">=8.1",
    "gexo/php-image-editor": "^1.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
  },
  "autoload": {
    "psr-4": {
      "DantSu\\OpenStreetMapStaticAPI\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DantSu\\OpenStreetMapStaticAPI\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
